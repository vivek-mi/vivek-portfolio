# Copy this to .env and fill in your values. Never commit .env to git.
# The contact form needs at least one of: Gmail SMTP (emails you) or MongoDB (stores messages).

PORT=3000
NODE_ENV=development

# Site URL allowed by CORS (your Vercel URL in production)
FRONTEND_URL=http://localhost:4200

# Gmail: each message is emailed to NOTIFY_EMAIL.
# SMTP_PASS must be a Gmail App Password (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_app_password_here
NOTIFY_EMAIL=vivek79054@gmail.com

# Optional: MongoDB Atlas, stores each message for 90 days. Remove the # and paste your connection string.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
